GCP_PROJECT_ID=
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MOCK_MODE=false

# --- Opcionális beállítások (mindegyiknek van kódbeli alapértelmezettje) ---
# Vertex AI mód. Alapértelmezett: false (AI Studio, API-kulccsal).
#
# Miért érdemes: a GCP $300-as ingyenes kerete az AI Studio-n keresztüli
# Gemini API-t NEM fedezi (a Google doksija szó szerint: "The $300 credit
# can't pay for Gemini API in AI Studio costs"). A Vertex AI-on futó Gemini
# viszont sima GCP-szolgáltatásként számlázódik, tehát a keretből fedezhető.
#
# Vertex módban NEM kell GEMINI_API_KEY: a hitelesítés a környezet
# alapértelmezett hitelesítő adataival (ADC) történik — Cloud Runon
# automatikusan a szolgáltatásfiókkal, helyben pedig:
#     gcloud auth application-default login
# Feltétel: az aiplatform.googleapis.com API engedélyezve a projektben.
# GEMINI_USE_VERTEX=true
# A Vertex AI régiója. Alapértelmezett: europe-west1
# GCP_LOCATION=europe-west1
# Használt Gemini modell. Alapértelmezett: gemini-2.5-flash
# Az ingyenes szinten a -lite változatnak jellemzően nagyobb a kerete, és
# erre a feladatra (0-100 relevancia-pontozás) bőven elég:
# GEMINI_MODEL=gemini-2.5-flash-lite
# Minimális szünet két Gemini-hívás között másodpercben. Alapértelmezett: 6.0
# (<= 10 kérés/perc, biztonságos az ingyenes szint percenkénti limitjéhez).
# Fizetős szinten csökkenthető.
# GEMINI_MIN_INTERVAL_SEC=6.0
# Napi költségriasztási küszöb USD-ben. Alapértelmezett: 0.05
# MAX_DAILY_COST_USD=0.05
# Vesszővel elválasztott lista a scraper célú URL-jeiről — felülírja a
# tools/scraper.py-ban hardcode-olt alapértelmezett profession.hu/cvonline.hu listát.
# TARGET_URLS=https://www.profession.hu/allasok/...,https://www.cvonline.hu/...
